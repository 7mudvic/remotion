{
  "name": "restaurant-menu-slideshow",
  "version": "1.0.0",
  "description": "Premium cinematic restaurant menu slideshow built with Remotion for in-store TV display.",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render MenuShow out/menu-show.mp4",
    "build:hq": "remotion render MenuShow out/menu-show.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p",
    "build:prores": "remotion render MenuShow out/menu-show.mov --codec=prores --prores-profile=4444",
    "upgrade": "remotion upgrade",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.395",
    "@remotion/cli": "4.0.395",
    "@remotion/google-fonts": "4.0.395",
    "@remotion/noise": "4.0.395",
    "@remotion/paths": "4.0.395",
    "@remotion/renderer": "4.0.395",
    "@remotion/shapes": "4.0.395",
    "@remotion/studio": "4.0.395",
    "@remotion/transitions": "4.0.395",
    "@remotion/zod-types": "4.0.395",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.395",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "typescript": "5.6.3"
  }
}
